{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imlam.com/contracts/execution_plan_v2.schema.json",
  "title": "Immutable Swing Execution Plan V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "plan_id",
    "model_version",
    "execution_date",
    "order_count",
    "payload_sha256",
    "orders",
    "pre_trade_state_sha256",
    "pre_trade_state"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "generated_at": {"type": "string", "minLength": 10},
    "plan_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "execution_date": {"type": "string", "minLength": 10},
    "order_count": {"type": "integer", "minimum": 1},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "orders": {"type": "object"},
    "pre_trade_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_trade_state": {"type": "object"}
  }
}
