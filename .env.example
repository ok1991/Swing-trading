ROTATION_URL=https://etf.imlam.com/etf_rotation_latest.json
# Same-host default: prefer ../ETF-main/public/etf_rotation_latest.json.
# Set LOCAL_ROTATION_SOURCE= to disable it, or ROTATION_SOURCE_PRIORITY=remote_first.
# LOCAL_ROTATION_SOURCE=../ETF-main/public/etf_rotation_latest.json
ROTATION_SOURCE_PRIORITY=local_first
AUTO_GIT_PUSH=true
GITHUB_TOKEN=ghp_your_token
GITHUB_REPO=ok1991/Swing-trading
FEEDBACK_PUBLISH_TARGET=execution_feedback_latest.json
FEEDBACK_HISTORY_PUBLISH_TARGET=execution_feedback_history.json
LIVE_PERFORMANCE_PUBLISH_TARGET=live_performance_latest.json
# FEEDBACK_ONLY=true
# BROKER_FILLS_FILE=/path/to/broker_fills.json
# APPLY_BROKER_STATE=true
# Virtual/paper accounts can confirm generated orders automatically. Do not
# enable this for a real brokerage account.
# VIRTUAL_BROKER_CONFIRM=true
PUBLISH_TARGET=index.html
GIT_BRANCH=main
INITIAL_CAPITAL=10000
COMMISSION_RATE=0.00015
MINIMUM_COMMISSION=0
MAX_ROTATION_AGE_TRADING_DAYS=2
MAX_ROTATION_GENERATED_AGE_HOURS=96
